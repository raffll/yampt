{
    "name": "Google Cloud",
    "kind": "simple",
    "endpoint": "https://translation.googleapis.com/language/translate/v2",
    "body_format": "json",
    "headers": {
        "Content-Type": "application/json",
        "x-goog-api-key": "{{api_key}}"
    },
    "body": {
        "q": "{{text}}",
        "target": "{{target_lang}}",
        "source": "{{source_lang}}",
        "format": "text"
    },
    "response_path": "data.translations[0].translatedText",
    "quota_limit": 500000,
    "settings": [
        {
            "key": "api_key",
            "label": "API Key",
            "type": "password"
        }
    ]
}
