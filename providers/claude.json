{
    "name": "Claude",
    "kind": "chat_completion",
    "message_style": "anthropic",
    "endpoint": "https://api.anthropic.com/v1/messages",
    "models_endpoint": "https://api.anthropic.com/v1/models",
    "models_path": "data",
    "models_id_key": "id",
    "body_format": "json",
    "headers": {
        "Content-Type": "application/json",
        "x-api-key": "{{api_key}}",
        "anthropic-version": "2023-06-01"
    },
    "body": {
        "model": "{{model}}",
        "max_tokens": "4096"
    },
    "response_path": "content[0].text",
    "system_prompt": "You are a translator for the video game Morrowind. Translate the given text from {{source_lang_upper}} to {{target_lang}}. Output only the translated text, nothing else. Preserve all HTML tags, line breaks, and formatting exactly as they appear.",
    "quota_limit": 0,
    "settings": [
        {
            "key": "api_key",
            "label": "API Key",
            "type": "password"
        },
        {
            "key": "model",
            "label": "Model",
            "type": "choice",
            "choices": ["claude-sonnet-4-20250514", "claude-haiku-4-20250514", "claude-3-5-sonnet-20241022"],
            "default": "claude-sonnet-4-20250514"
        }
    ]
}
